# ── Server ──────────────────────────────────────
PORT=8080
ENV=development

# ── PostgreSQL ──────────────────────────────────
DATABASE_URL=postgres://mifinca:mifinca_secret@localhost:5432/mifinca_db?sslmode=disable

# ── Redis ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ─────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-at-least-32-chars!!
JWT_ACCESS_DURATION=24h
JWT_REFRESH_DURATION=720h

# ── S3 / MinIO ──────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mifinca-photos
S3_REGION=us-east-1
